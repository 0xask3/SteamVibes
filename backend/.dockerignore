# Platform-specific: a Windows .venv inside a Linux image is a broken
# interpreter rather than an error.
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/

# The image reads config from compose, and baking a .env into a layer would
# ship the database password with it.
.env

# Narrow rather than excluding eval/ wholesale, because queries.yaml is needed.
*.md
