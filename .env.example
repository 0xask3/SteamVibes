# Copy to .env and adjust. .env is gitignored.

POSTGRES_USER=steam
POSTGRES_PASSWORD=steam
POSTGRES_DB=steamvibe
POSTGRES_PORT=5432

# psycopg 3 driver. Use 127.0.0.1, never localhost — see NOTES.md 2026-08-20.
# Host becomes `db` when the backend runs inside compose.
DATABASE_URL=postgresql+psycopg://steam:steam@127.0.0.1:5432/steamvibe

# 127.0.0.1 = native Ollama on the host (GPU).
# `http://ollama:11434` = the compose service (CPU unless the toolkit is set up).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Weekend 1 embedding model. Weekend 3 swaps this for bge-m3 (1024 dims)
# and re-embeds — the dimension is part of the schema, so it is a migration.
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Games with positive+negative <= this are hidden from results. Everything is
# embedded regardless, so this is a runtime knob — Weekend 3 measures recall
# at 0 / 10 / 20 / 50 by changing it here.
REVIEW_THRESHOLD=10

# How long Ollama holds the model in VRAM after a request. Its default of 5m
# means an idle CLI pays ~18s reloading the model to do ~20ms of work.
OLLAMA_KEEP_ALIVE=30m
