# Copy to .env and adjust: `cp .env.example .env`. .env is gitignored.
#
# DATABASE_URL is the only setting with no default in app/config.py, so without
# a .env the app does not start at all. Everything else below is a documented
# override of a working default.

POSTGRES_USER=steam
POSTGRES_PASSWORD=steam
POSTGRES_DB=steamvibe
POSTGRES_PORT=5432

# psycopg 3 driver. Use 127.0.0.1, never localhost — see NOTES.md 2026-08-20.
# Host becomes `db` when the backend runs inside compose.
DATABASE_URL=postgresql+psycopg://steam:steam@127.0.0.1:5432/steamvibe

# 127.0.0.1 = native Ollama on the host (GPU).
# `http://ollama:11434` = the compose service (CPU unless the toolkit is set up).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Migration 0006 widened the column to 1024, so these three swap freely —
# change this, then `embed_all --reload`:
#   snowflake-arctic-embed2   qwen3-embedding:0.6b   bge-m3
# arctic is the measured winner over the other two on 118 labelled queries;
# see eval/failures.md #30. The query/document prefixes follow the model
# automatically (app/embedding.py). There is no EMBED_DIM: the width is
# EMBEDDING_DIM in app/models.py, set by the migration.
EMBED_MODEL=snowflake-arctic-embed2

# Games with positive+negative <= this are hidden from results. Everything is
# embedded regardless, so this is a runtime knob.
REVIEW_THRESHOLD=10

# How long Ollama holds the model in VRAM after a request. Its default of 5m
# means an idle CLI pays ~18s reloading the model to do ~20ms of work.
OLLAMA_KEEP_ALIVE=30m

# Chat model for the query parser. Swap freely — see eval/compare_parsers.py.
CHAT_MODEL=qwen3.5:9b

# Qwen3.5 thinks by default. The parser extracts fields, it does not reason, and
# it sits in the request path. Blank omits the flag entirely, which a model with
# no thinking mode requires - Ollama 400s on `think` rather than ignoring it.
CHAT_THINK=false

# The system prompt carries all 452 tags. Ollama's default window is close
# enough to that to risk a silent truncation, which would drop tags off the
# end of the vocabulary.
CHAT_NUM_CTX=8192

# ---------------------------------------------------------------- ranking ----
# Mostly commented out: the defaults in app/config.py ARE the measured, shipped
# values, and these are here to be found rather than edited casually. Ranking
# changes go through the eval - read `tail` and the tail-cost counter-metric,
# never `core` or `specific`.
#
# RANK_METHOD=rerank           # none | log | rrf | rerank   (default: rerank)
# POPULARITY_WEIGHT=0.20       # largest value that does not cost tail recall
# RRF_K=60
# RERANK_CANDIDATES=200        # must not exceed HNSW_EF_SEARCH. Also the pool
#                              # the cross-encoder scores, and 200 is measured:
#                              # every reachable `specific` target is inside
#                              # rank 100, and 200->500 buys 14 more `core`
#                              # targets, the tier that cannot price this.
# HNSW_EF_SEARCH=200           # pgvector's default of 40 costs 3.3 recall points

# Ollama's physical batch for embedding. Raising it past the model's context
# does nothing. Never change this mid-corpus: it alters float summation order,
# so half the vectors end up subtly different and nothing downstream notices.
# EMBED_NUM_BATCH=4096

# ------------------------------------------------------------- reranking ----
# Stage 3, and ON by default: a cross-encoder rescores the candidate pool and
# its rank replaces the cosine rank inside the same rrf sum. Worth 5.6 recall
# points overall and 9.1 on `specific` - see eval/failures.md #36.
#
# SET RANK_METHOD=rrf IF YOU HAVE NO NVIDIA GPU. There is no server to start:
# app/rerank.py loads the model in-process, because Ollama has no rerank
# endpoint and TEI cannot reach the GPU through Docker Desktop's WSL2 backend
# (NOTES.md 2026-09-07). Without a GPU it fails to load, logs a WARNING and
# falls back to `rrf` on every search - correct, but you should just say so.
# The containerised backend cannot rerank at all; docker-compose pins it to rrf.
#
# torch must come from PyTorch's own index or you get a CPU-only build whose
# ONLY symptom is torch.cuda.is_available() == False, which looks like a broken
# GPU rather than a wrong wheel. pyproject.toml pins that; do not `uv add torch`.
RERANK_DEVICE=cuda

# The cross-encoder. Qwen3-Reranker-0.6B and bge-reranker-v2-m3 are NOT
# distinguishable on recall - +2.7% with a 95% CI of [-2.1%, +7.6%], and 102 of
# 118 queries score identically. Qwen3 is the default on a deterministic
# behaviour the eval cannot score: for "city builder" bge drops Cities: Skylines
# II to rank 37 behind a 78-review game literally named `City Builder`, while
# Qwen3 holds it at rank 1. bge is 4x faster (264ms against 1,021ms) for the
# same recall, so set it here if latency matters at all.
# Each model's input template lives in app/rerank.py, keyed on this name.
# RERANK_MODEL=tomaarsen/Qwen3-Reranker-0.6B-seq-cls

# The task description handed to an instruction-following reranker; ignored by
# models that cannot take one. It is a TUNED PROMPT - re-run the eval after
# touching it, the way the parser prompt is treated.
# RERANK_INSTRUCTION=Given a description of the feeling or content a player wants, retrieve video games matching it.
# RERANK_BATCH_SIZE=128        # pairs per forward pass; lower this before the
#                              # pool if VRAM is tight - the pool decides which
#                              # targets are reachable, this only decides speed.

# Executes Python from the model repo at load time. Off unless a model needs it.
# RERANK_TRUST_REMOTE_CODE=false

# Optional. Unauthenticated Hub downloads are rate limited hard enough to stall
# a 1.2GB model at 9KB, which looks like a hang rather than a limit.
# HUGGING_FACE=hf_...
