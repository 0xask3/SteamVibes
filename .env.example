# Copy to .env and adjust: `cp .env.example .env`. .env is gitignored.
#
# DATABASE_URL is the only setting with no default in app/config.py, so without
# a .env the app does not start. Everything else is a documented override.

POSTGRES_USER=steam
POSTGRES_PASSWORD=steam
POSTGRES_DB=steamvibe
POSTGRES_PORT=5432

# psycopg 3. Use 127.0.0.1, never localhost - on Windows that resolves to IPv6
# ::1 first and costs ~2.1s per connection. Host becomes `db` inside compose.
DATABASE_URL=postgresql+psycopg://steam:steam@127.0.0.1:5432/steamvibe

# 127.0.0.1 = native Ollama on the host (GPU). `http://ollama:11434` = the
# compose service, which is CPU unless the NVIDIA toolkit is set up.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# arctic, qwen3-embedding:0.6b and bge-m3 are all 1024 dims, so they swap
# freely: change this, then `embed_all --reload`. arctic is the measured winner
# of the three (failures.md #30), and the query/document prefixes follow the
# model automatically. There is no EMBED_DIM - the width is set by migration.
EMBED_MODEL=snowflake-arctic-embed2

# Games with positive+negative <= this are hidden from results. Everything is
# embedded regardless, so this is a runtime knob.
REVIEW_THRESHOLD=10

# How long Ollama holds the model in VRAM. Its 5m default means an idle CLI
# pays ~18s reloading it to do ~20ms of work.
OLLAMA_KEEP_ALIVE=30m

# Chat model for the query parser. Swap freely - see eval/compare_parsers.py.
CHAT_MODEL=qwen3.5:9b

# The parser extracts fields, it does not reason, and it sits in the request
# path. Blank omits the flag entirely, which a model with no thinking mode
# requires - Ollama 400s on `think` rather than ignoring it.
CHAT_THINK=false

# Must hold the ~1,800-token vocabulary prompt: an overflow truncates silently
# from the end, dropping tags off the list.
CHAT_NUM_CTX=8192

# ---------------------------------------------------------------- ranking ----
# Commented out because the defaults in app/config.py ARE the shipped, measured
# values. Ranking changes go through the eval - read `tail` and the tail-cost
# counter-metric, never `core` or `specific`.
#
# RANK_METHOD=rerank           # none | log | rrf | rerank   (default: rerank)
# POPULARITY_WEIGHT=0.20       # largest value that does not cost tail recall
# RRF_K=60
# RERANK_CANDIDATES=200        # must not exceed HNSW_EF_SEARCH. Also the pool
#                              # the cross-encoder scores: every reachable
#                              # `specific` target is inside rank 100, and
#                              # 200->500 buys only `core` targets.
# HNSW_EF_SEARCH=800           # smallest value where results stop depending on
#                              # which graph the (non-deterministic, parallel)
#                              # index build produced. failures.md #42.
# EMBED_NUM_BATCH=4096         # Ollama's physical batch. NEVER change this
#                              # mid-corpus: it alters float summation order,
#                              # so half the vectors end up subtly different
#                              # and nothing downstream notices.

# ------------------------------------------------------------- reranking ----
# Stage 3, ON by default: a cross-encoder rescores the pool and its rank
# replaces the cosine rank inside the same rrf sum. Worth +10.6% overall.
#
# SET RANK_METHOD=rrf IF YOU HAVE NO NVIDIA GPU. There is no server to start -
# app/rerank.py loads the model in-process, because Ollama has no rerank
# endpoint and TEI cannot reach the GPU through Docker Desktop's WSL2 backend.
# Without a GPU it fails to load, warns and falls back on every search, which
# is correct but not worth watching. The container cannot rerank at all, so
# docker-compose pins it to rrf.
#
# torch must come from PyTorch's own index or you get a CPU-only build whose
# only symptom is torch.cuda.is_available() == False. pyproject.toml pins that;
# do not `uv add torch`.
RERANK_DEVICE=cuda

# Qwen3-Reranker-0.6B and bge-reranker-v2-m3 are NOT distinguishable on recall.
# Qwen3 is the default on a behaviour the eval cannot score: for "city builder"
# bge drops Cities: Skylines II to rank 37 behind a 78-review game named `City
# Builder`, while Qwen3 holds it at 1. bge is 4x faster for the same recall.
# Each model's input template lives in app/rerank.py, keyed on this name.
# RERANK_MODEL=tomaarsen/Qwen3-Reranker-0.6B-seq-cls

# The task description handed to an instruction-following reranker; ignored by
# models that cannot take one. A TUNED PROMPT - re-run the eval after touching
# it, the way the parser prompt is treated.
# RERANK_INSTRUCTION=Given a description of the feeling or content a player wants, retrieve video games matching it.
# RERANK_BATCH_SIZE=32         # pairs per forward pass, and not only a speed
#                              # knob: fp16 can reorder near-ties. 32 is
#                              # measured - less VRAM AND faster than 128.
#                              # Check compare_runs first.

# Executes Python from the model repo at load time. Off unless a model needs it.
# RERANK_TRUST_REMOTE_CODE=false

# Optional. Unauthenticated Hub downloads are rate limited hard enough to stall
# a download, which looks like a hang rather than a limit.
# HUGGING_FACE=hf_...

# --- query relaxation -------------------------------------------------------
# When the filters cannot fill a page, widen them one at a time. The ladder and
# the never-relax list (age limits, excluded tags, excluded games, the
# multiplayer axis, platforms) live in app/relax.py. run_eval pins this OFF
# regardless: recall must be measured against a FIXED filter set.
# RELAX_FILTERS=true
# RELAX_TARGET_ROWS=            # rows that must pass before relaxing stops.
#                               # Empty = the requested limit, deliberately
#                               # conservative: relaxing while the filters can
#                               # still fill the page overrides a constraint
#                               # the user actually stated.

# --- observability ----------------------------------------------------------
# How many REQUESTS (not seconds) GET /api/stats keeps per endpoint, in memory.
# Per-process, lost on restart, and recorded at the endpoint - so it sees API
# traffic only and is NOT the same measurement as the median run_eval prints.
# p95 is withheld below 21 samples, which is a module constant rather than a
# setting because below that the 95th percentile IS the maximum.
# STATS_WINDOW=500
