# Copy to .env and adjust: `cp .env.example .env`. .env is gitignored.
#
# DATABASE_URL is the only setting with no default in app/config.py, so without
# a .env the app does not start at all. Everything else below is a documented
# override of a working default.

POSTGRES_USER=steam
POSTGRES_PASSWORD=steam
POSTGRES_DB=steamvibe
POSTGRES_PORT=5432

# psycopg 3 driver. Use 127.0.0.1, never localhost — see NOTES.md 2026-08-20.
# Host becomes `db` when the backend runs inside compose.
DATABASE_URL=postgresql+psycopg://steam:steam@127.0.0.1:5432/steamvibe

# 127.0.0.1 = native Ollama on the host (GPU).
# `http://ollama:11434` = the compose service (CPU unless the toolkit is set up).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Migration 0006 widened the column to 1024, so these three swap freely —
# change this, then `embed_all --reload`:
#   snowflake-arctic-embed2   qwen3-embedding:0.6b   bge-m3
# arctic is the measured winner over the other two on 118 labelled queries;
# see eval/failures.md #30. The query/document prefixes follow the model
# automatically (app/embedding.py). There is no EMBED_DIM: the width is
# EMBEDDING_DIM in app/models.py, set by the migration.
EMBED_MODEL=snowflake-arctic-embed2

# Games with positive+negative <= this are hidden from results. Everything is
# embedded regardless, so this is a runtime knob.
REVIEW_THRESHOLD=10

# How long Ollama holds the model in VRAM after a request. Its default of 5m
# means an idle CLI pays ~18s reloading the model to do ~20ms of work.
OLLAMA_KEEP_ALIVE=30m

# Chat model for the query parser. Swap freely — see eval/compare_parsers.py.
CHAT_MODEL=qwen3.5:9b

# Qwen3.5 thinks by default. The parser extracts fields, it does not reason, and
# it sits in the request path. Blank omits the flag entirely, which a model with
# no thinking mode requires - Ollama 400s on `think` rather than ignoring it.
CHAT_THINK=false

# The system prompt carries all 452 tags. Ollama's default window is close
# enough to that to risk a silent truncation, which would drop tags off the
# end of the vocabulary.
CHAT_NUM_CTX=8192

# ---------------------------------------------------------------- ranking ----
# Commented out: the defaults in app/config.py are the measured, shipped values
# and these are here to be found, not to be edited casually. Ranking changes go
# through the eval — read `tail` and the tail-cost counter-metric, never `core`.
#
# RANK_METHOD=rrf              # none | log | rrf
# POPULARITY_WEIGHT=0.20       # largest value that does not cost tail recall
# RRF_K=60
# RERANK_CANDIDATES=200        # must not exceed HNSW_EF_SEARCH
# HNSW_EF_SEARCH=200           # pgvector's default of 40 costs 3.3 recall points

# Ollama's physical batch for embedding. Raising it past the model's context
# does nothing. Never change this mid-corpus: it alters float summation order,
# so half the vectors end up subtly different and nothing downstream notices.
# EMBED_NUM_BATCH=4096
